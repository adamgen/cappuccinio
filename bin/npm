#!/bin/bash
cd "$(dirname "$0")" || exit

bump(){
  cd ../static/src || exit 1
  local type=$1

  if [ "$type" == "pre" ]; then
    npm version prerelease --preid alpha
  fi

  if [ "$type" == "pre-t" ]; then
    npm version prerelease --preid alpha-t
  fi
}

publish(){
  cd ../static/src || exit 1
  npm publish
}



cmd=$1
shift
$cmd "$@"
